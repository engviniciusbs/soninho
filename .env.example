# Copy to .env.local and fill in. Placeholders only - never commit real values.

# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase public anon key (respects RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Supabase service role key (bypasses RLS - server only, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public base URL used in email links (optional, defaults to https://soninho.baby)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI API key (chat and regression analysis)
OPENAI_API_KEY=your-openai-api-key
# Resend API key (weekly email report)
RESEND_API_KEY=your-resend-api-key

# VAPID key pair for Web Push: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID contact, must start with mailto:
VAPID_CONTACT_EMAIL=mailto:you@example.com

# Secret for cron endpoints (Authorization: Bearer <CRON_SECRET>): openssl rand -hex 32
CRON_SECRET=your-long-random-string
